# Archivos que se ejecutan dentro de contenedores Linux: deben quedar con saltos
# de línea LF aunque el desarrollador use Windows (core.autocrlf=true). Con CRLF
# el `#!/bin/sh` de mvnw falla en Docker con "./mvnw: not found" (código 127).
mvnw text eol=lf
*.sh text eol=lf
Dockerfile text eol=lf
*.sql text eol=lf
*.conf text eol=lf
*.template text eol=lf
