digraph SGO_Despliegue {
  graph [
    label=<<B>SGO-Logic - Vista de Despliegue Inicial y Evolucion</B><BR/><FONT POINT-SIZE="11">Estado objetivo inicial on-premises; cantidades y productos quedan sujetos a ADR y pruebas</FONT>>,
    labelloc=t,
    rankdir=LR,
    bgcolor="#F8FAFC",
    fontname="Arial",
    fontsize=15,
    pad=0.30,
    nodesep=0.42,
    ranksep=0.72,
    splines=ortho,
    compound=true
  ];

  node [
    shape=box3d,
    style="filled",
    fillcolor="#FFFFFF",
    color="#94A3B8",
    fontcolor="#0F172A",
    fontname="Arial",
    fontsize=8.5,
    margin="0.13,0.09"
  ];
  edge [
    color="#64748B",
    fontcolor="#334155",
    fontname="Arial",
    fontsize=7.5,
    arrowsize=0.65
  ];

  subgraph cluster_clientes {
    label="Canales y redes de usuario";
    color="#93C5FD";
    fillcolor="#EFF6FF";
    style="rounded,filled";
    fontname="Arial";
    fontcolor="#1E3A8A";

    internet [label="Web y app movil\nDispositivos cliente"];
    red_tienda [label="Tiendas\nCanal de venta"];
    red_atencion [label="Centro de atencion\nEstaciones de trabajo"];
  }

  subgraph cluster_onprem {
    label="Centro de datos MegaStore - despliegue inicial on-premises";
    color="#60A5FA";
    fillcolor="#EFF6FF";
    style="rounded,filled";
    fontname="Arial";
    fontcolor="#1E3A8A";

    entrada [
      color="#818CF8",
      fillcolor="#E0E7FF",
      label="<<node>> Entrada segura\nProxy / balanceo logico\nProducto y redundancia: por decidir"
    ];

    subgraph cluster_app {
      label="<<executionEnvironment>> Runtime de aplicaciones";
      color="#A5B4FC";
      fillcolor="#EEF2FF";
      style="rounded,filled";
      fontname="Arial";

      sgo [
        color="#2563EB",
        fillcolor="#DBEAFE",
        penwidth=2,
        label="<<artifact>> SGO-Logic\nMonolito modular + API\nN instancias; N se define por prueba 8x\n[EaC-01, EaC-03, EaC-09]"
      ];
      workers [
        color="#F59E0B",
        fillcolor="#FEF3C7",
        label="<<artifact>> Trabajadores de integracion\nconsumidores, planificador de reintentos\ny exportador ERP\n[EaC-05, EaC-06, EaC-08]"
      ];
      resiliencia [
        shape=component,
        color="#F59E0B",
        fillcolor="#FEF3C7",
        label="Adaptadores de salida\nTimeout + Circuit Breaker PayKlik\nRetry/backoff LogiExpress\nLibro idempotente por integracion\nTLS + tokenizacion; sin PAN/CVV\n[EaC-04, EaC-05, EaC-12]"
      ];
    }

    subgraph cluster_datos {
      label="<<node>> Persistencia y mensajeria";
      color="#6EE7B7";
      fillcolor="#ECFDF5";
      style="rounded,filled";
      fontname="Arial";

      db [
        shape=cylinder,
        color="#10B981",
        fillcolor="#D1FAE5",
        label="Base operacional\nEsquemas logicos por modulo\nOrden e intentos persistidos\nCifrado/retencion: por decidir"
      ];
      auditoria [
        shape=cylinder,
        color="#10B981",
        fillcolor="#D1FAE5",
        label="Registro y lectura de auditoria\nquien / cuando / que cambio\nconsulta objetivo < 1 s\n[EaC-02, EaC-07]"
      ];
      outbox [
        shape=cylinder,
        color="#F59E0B",
        fillcolor="#FEF3C7",
        label="Outbox transaccional\ncambio de negocio + mensaje\n[ADR-002 / EaC-07]"
      ];
      broker [
        color="#F59E0B",
        fillcolor="#FEF3C7",
        label="Broker de mensajes\ncolas de trabajo y entrega eventual\n[EaC-04, EaC-05, EaC-06, EaC-08]"
      ];
      dlq [
        shape=folder,
        color="#F97316",
        fillcolor="#FFEDD5",
        label="Mensajes fallidos / DLQ\ninspeccion y reproceso controlado"
      ];
      archivos [
        shape=folder,
        color="#10B981",
        fillcolor="#D1FAE5",
        label="Area de intercambio ERP\nCSV/XML por ventana de 30 min"
      ];
    }

    subgraph cluster_ops {
      label="<<node>> Operacion y observabilidad";
      color="#C4B5FD";
      fillcolor="#F5F3FF";
      style="rounded,filled";
      fontname="Arial";

      observabilidad [
        color="#8B5CF6",
        fillcolor="#EDE9FE",
        label="Metricas, logs, trazas y alertas\ncorrelacion por orden/transaccion\nAPI, adaptadores, Outbox, colas y DLQ\n[ADR-006 / EaC-03, EaC-04, EaC-09]"
      ];
      operacion [
        shape=box,
        style="rounded,filled",
        color="#8B5CF6",
        fillcolor="#EDE9FE",
        label="TI / Equipo interno\noperacion, diagnostico y recuperacion"
      ];
    }

    entrada -> sgo [label="HTTPS\n[EaC-01]"];
    sgo -> db [dir=both, label="contrato de persistencia"];
    sgo -> auditoria [dir=both, label="evidencia y consulta"];
    sgo -> outbox [label="misma transaccion local"];
    outbox -> broker [label="publicacion confiable\nADR-002"];
    broker -> workers [label="mensajes"];
    workers -> broker [label="confirmacion / reintento"];
    broker -> dlq [label="maximos agotados"];
    workers -> archivos [label="genera CSV/XML"];
    sgo -> resiliencia [label="puertos de salida"];
    sgo -> observabilidad [style=dashed, label="telemetria"];
    workers -> observabilidad [style=dashed, label="telemetria"];
    broker -> observabilidad [style=dashed, label="profundidad / fallos"];
    dlq -> observabilidad [style=dashed, label="alerta"];
    operacion -> observabilidad [dir=both, style=dashed, label="consulta y alertas"];
  }

  internet -> entrada [label="HTTPS"];
  red_tienda -> entrada [label="contrato de canal por confirmar"];
  red_atencion -> entrada [label="HTTPS / red corporativa"];

  subgraph cluster_externos {
    label="Sistemas existentes y proveedores";
    color="#FCA5A5";
    fillcolor="#FEF2F2";
    style="rounded,filled";
    fontname="Arial";
    fontcolor="#991B1B";

    payklik [label="PayKlik\nREST; 800 ms tipico, hasta 5 s"];
    sat [label="SAT\nFactura XML; respuesta variable"];
    logiexpress [label="LogiExpress\nREST; ~2% timeout"];
    erp [label="ERP-Core AS/400\nCSV/XML cada 30 min"];
    pos [label="POS x32\nreceptores de eventos"];
    notif [label="SMS / correo / push\nproveedor no controlado"];
  }

  resiliencia -> payklik [dir=both, label="REST\nCircuit Breaker [EaC-04]"];
  resiliencia -> sat [dir=both, label="XML / respuesta\nestado fiscal pendiente [ADR-007]"];
  resiliencia -> logiexpress [dir=both, label="REST\nretry/backoff [EaC-05]"];
  archivos -> erp [label="CSV/XML cada 30 min\n[R1]"];
  workers -> pos [label="eventos + reintentos\n[EaC-06]"];
  workers -> notif [label="asincrono no bloqueante\n[ADR-008 / EaC-08]"];

  subgraph cluster_futuro {
    label="Ruta futura planificada - no representa el despliegue inicial";
    color="#86EFAC";
    fillcolor="#F0FDF4";
    style="rounded,dashed,filled";
    fontname="Arial";
    fontcolor="#166534";

    nube [
      color="#22C55E",
      fillcolor="#DCFCE7",
      label="<<cloud>> Plataforma de nube por seleccionar\nartefactos portables + equivalentes de datos/mensajeria\nextraccion gradual de modulos solo si se justifica\n[EaC-11 / R6]"
    ];
  }

  sgo -> nube [style=dashed, color="#16A34A", label="migracion planificada\nno replica del estado actual"];
  broker -> nube [style=dashed, color="#16A34A"];

  restricciones [
    shape=note,
    style="filled",
    color="#FDBA74",
    fillcolor="#FFF7ED",
    fontsize=8,
    label="Restricciones visibles: inicio on-premises, ERP/POS sin cambios, stack mantenible.\nLa topologia final debe demostrar costo <= USD 1,200/mes o documentar aprobacion.\nNo se fijan replicas, RTO, RPO ni productos sin evidencia adicional."
  ];
  nube -> restricciones [style=invis];
}
