server {
    listen 8080;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Sitio multi-página real (index/cliente/staff), no una SPA: cada ruta
    # sirve su propio archivo; sin fallback a index.html.
    # Sin build tooling no hay cache-busting por hash de archivo, así que
    # cualquier caché del navegador sirve HTML/JS viejo tras un rebuild del
    # contenedor (bug recurrente ya visto en inventory-service) — se
    # deshabilita toda caché para que cada carga siempre pida la versión
    # actual.
    location / {
        add_header Cache-Control "no-store" always;
        try_files $uri $uri/ =404;
    }

    # Las imágenes no cambian entre despliegues (la portada pesa ~1.8 MB):
    # el navegador las reutiliza un día en vez de descargarlas en cada página.
    location ~* \.(png|jpe?g|webp|svg|ico)$ {
        add_header Cache-Control "public, max-age=86400" always;
        try_files $uri =404;
    }

    # Comprime HTML, CSS, JS y JSON de la API: en la nube la latencia y el
    # tamaño de cada respuesta se notan mucho más que en localhost.
    gzip on;
    gzip_comp_level 5;
    gzip_min_length 1024;
    gzip_proxied any;
    gzip_types text/css application/javascript application/json image/svg+xml;

    # Evita CORS: el navegador solo habla con nginx, que reenvía al backend
    # dentro de la red interna de Compose.
    # Imágenes del catálogo que sube la tienda online (máx. 2 MB en el backend).
    client_max_body_size 5m;

    location /api/ {
        proxy_pass http://${BACKEND_HOST}:${BACKEND_INTERNAL_PORT}/api/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Correlation-Id $http_x_correlation_id;
        proxy_set_header Idempotency-Key $http_idempotency_key;
    }
}
