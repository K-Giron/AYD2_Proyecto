# Copiar como .env.performance y ajustar al ambiente. No versionar credenciales reales.
BASE_URL=http://host.docker.internal:8080
RUN_ID=20261014-local-01

# Barreras de seguridad. Solo habilitar en el ambiente académico autorizado.
ALLOW_MUTATIONS=false
ALLOW_STRESS=false

# Cuentas locales ficticias. En nube deben proporcionarse como secretos.
CLIENT_USER=cliente@megastore.com
CLIENT_PASSWORD=Cliente123
FINANCE_USER=finanzas@megastore.com
FINANCE_PASSWORD=Finanzas123
SUPPORT_USER=staff@megastore.com
SUPPORT_PASSWORD=Staff123

# En nube, sustituir las cuentas por las entregadas por Kevin únicamente en
# .env.performance (ignorado por Git); no guardar secretos en este ejemplo.

# Contratos reales integrados en develop (credit-history-v1 y Saga dual).
ERP_HISTORY_PATH=/api/v1/credit/history
NOTIFICATIONS_PATH=/api/v1/notifications
ORDER_SUMMARY_PATH_TEMPLATE=/api/v1/orders/{orderId}/summary
AUDIT_PATH_TEMPLATE=/api/v1/audit/events?orderId={orderId}
ORDER_PATH_TEMPLATE=/api/v1/orders/{orderId}
READINESS_PATH=/actuator/health/readiness
CREDIT_NOTIFICATION_EVENT=CREDIT_GRANTED

# Producto semilla de ORD-05. INVENTORY_TOPUP agrega unidades INBOUND solo
# durante prepare-dataset.js; dejar 0 hasta autorizar la mutación.
TEST_PRODUCT_ID=11111111-1111-1111-1111-111111111102
TEST_PRODUCT_NAME=Pantalón de lona negro
TEST_PRODUCT_PRICE=399
INVENTORY_TOPUP=0

# Dataset reproducible. Los UUID deben existir cuando el escenario consulta
# registros previamente sembrados.
CUSTOMERS=500
ORDERS=500
FIXED_SOURCE_ID=00000000-0000-4000-8000-000000900001
SMOKE_PAYMENT_ROUTE=PAYKLIK
SAGA_MAX_POLLS=12

# Valores de carga esperada. Cada script permite sobreescribirlos.
VUS=10
DURATION=2m
PAUSE=0.25

