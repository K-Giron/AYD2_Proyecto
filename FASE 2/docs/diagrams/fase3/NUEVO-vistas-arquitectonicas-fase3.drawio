        <mxCell id="de4" parent="1" edge="1" source="d-order" target="d-fiscal" value="referencia neutral" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#000000;fontColor=#000000;strokeWidth=2;endArrow=open;endFill=0;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="d-note" parent="1" vertex="1" value="Una operación REJECTED conserva trazabilidad, pero due_date es nulo y no representa deuda.&#xa;Las tablas comparten PostgreSQL físicamente; la propiedad lógica pertenece a credit, orders o fiscal." style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;strokeWidth=2;dashed=1;"><mxGeometry x="360" y="780" width="890" height="90" as="geometry"/></mxCell>
