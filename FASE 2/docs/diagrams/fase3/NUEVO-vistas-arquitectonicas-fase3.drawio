  <diagram id="f3-sequence" name="02-Secuencia-Saga-Dual">
    <mxGraphModel grid="1" gridSize="10" page="1" pageWidth="1600" pageHeight="1000" background="#FFFFFF" shadow="0">
      <root><mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="s-title" parent="1" vertex="1" value="Fase 3 — opciones y Saga financiera dual" style="whiteSpace=wrap;html=1;strokeColor=none;fillColor=none;fontColor=#000000;fontSize=24;fontStyle=1;"><mxGeometry x="250" y="30" width="1100" height="50" as="geometry"/></mxCell>
        <mxCell id="s-ui" parent="1" vertex="1" value="Cliente / UI" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;strokeWidth=2;"><mxGeometry x="60" y="100" width="180" height="60" as="geometry"/></mxCell>
        <mxCell id="s-orders" parent="1" vertex="1" value="orders / Saga" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;strokeWidth=2;"><mxGeometry x="390" y="100" width="180" height="60" as="geometry"/></mxCell>
        <mxCell id="s-credit" parent="1" vertex="1" value="credit" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;strokeWidth=2;"><mxGeometry x="720" y="100" width="180" height="60" as="geometry"/></mxCell>
        <mxCell id="s-fin" parent="1" vertex="1" value="payments / fiscal" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;strokeWidth=2;"><mxGeometry x="1050" y="100" width="210" height="60" as="geometry"/></mxCell>
        <mxCell id="s-note1" parent="1" vertex="1" value="1. GET payment-options&#xa;orders obtiene dueño y total persistidos&#xa;evaluate tiene timeout 2 s&#xa;falla / demora / rechazo ⇒ solo PAYKLIK" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;strokeWidth=2;"><mxGeometry x="80" y="220" width="560" height="150" as="geometry"/></mxCell>
        <mxCell id="s-note2" parent="1" vertex="1" value="2A. Ruta OWN_CREDIT&#xa;reserva → CREDIT_PENDING → requestCredit&#xa;GRANTED: CREDIT_APPROVED → fiscal → CONFIRMED&#xa;REJECTED: sin deuda; misma orden permite PAYKLIK" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;strokeWidth=2;"><mxGeometry x="720" y="220" width="560" height="170" as="geometry"/></mxCell>
        <mxCell id="s-note3" parent="1" vertex="1" value="2B. Ruta PAYKLIK&#xa;reserva → PAYMENT_PENDING → cobro/conciliación&#xa;PAYMENT_APPROVED → fiscal → CONFIRMED&#xa;No se invoca PayKlik en una compra a crédito" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;strokeWidth=2;"><mxGeometry x="80" y="480" width="560" height="160" as="geometry"/></mxCell>
        <mxCell id="s-note4" parent="1" vertex="1" value="Reintento y concurrencia&#xa;• misma Idempotency-Key ⇒ mismos identificadores&#xa;• UNIQUE por orden y llave&#xa;• advisory locks por llave y orderId&#xa;• Outbox/Inbox evita consumo duplicado" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;strokeWidth=2;fontStyle=1;"><mxGeometry x="720" y="480" width="560" height="180" as="geometry"/></mxCell>
        <mxCell id="se1" parent="1" edge="1" source="s-ui" target="s-orders" value="JWT firmado" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#000000;fontColor=#000000;strokeWidth=2;endArrow=open;endFill=0;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="se2" parent="1" edge="1" source="s-orders" target="s-credit" value="evaluate / requestCredit" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#000000;fontColor=#000000;strokeWidth=2;endArrow=open;endFill=0;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="se3" parent="1" edge="1" source="s-orders" target="s-fin" value="ruta elegida" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#000000;fontColor=#000000;strokeWidth=2;endArrow=open;endFill=0;"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
