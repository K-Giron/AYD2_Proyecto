// NUEVO (Fase 2, Kevin Girón): generado por generar-er-fase2.py desde las migraciones reales.
// No sustituye a SGO-Logic-Modelo-ER.drawio ni a modelo-datos.md.
digraph ER_Fase2 {
  graph [label=<<B>NUEVO · Modelo de datos Fase 2 — SGO-Logic — tablas NUEVAS de Fase 2 (onlinestore, inventorysync, customers, integration)</B><BR/><FONT POINT-SIZE="10">Generado desde Flyway · cada sistema tiene su base y no lee tablas de otro (solo API o eventos)</FONT>>, labelloc=t, rankdir=LR, fontname="Arial", fontsize=14, bgcolor="#F8FAFC", nodesep=0.2, ranksep=0.6];
  node [shape=plaintext, fontname="Arial", fontsize=8];
  edge [color="#64748B", arrowsize=0.6];
  inventory_bridge_dead_letters [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD COLSPAN="2" BGCOLOR="#DBEAFE"><B>inventory_bridge_dead_letters</B></TD></TR><TR><TD ALIGN="LEFT"><B>id</B> (PK)</TD><TD ALIGN="LEFT"><FONT COLOR="#64748B">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT">order_id</TD><TD ALIGN="LEFT"><FONT COLOR="#64748B">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT">product_id</TD><TD ALIGN="LEFT"><FONT COLOR="#64748B">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT">reason</TD><TD ALIGN="LEFT"><FONT COLOR="#64748B">varchar</FONT></TD></TR><TR><TD ALIGN="LEFT">attempts</TD><TD ALIGN="LEFT"><FONT COLOR="#64748B">integer</FONT></TD></TR><TR><TD ALIGN="LEFT">registered_at</TD><TD ALIGN="LEFT"><FONT COLOR="#64748B">timestamptz</FONT></TD></TR></TABLE>>];
  customers [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD COLSPAN="2" BGCOLOR="#DBEAFE"><B>customers</B></TD></TR><TR><TD ALIGN="LEFT"><B>id</B> (PK)</TD><TD ALIGN="LEFT"><FONT COLOR="#64748B">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT">username</TD><TD ALIGN="LEFT"><FONT COLOR="#64748B">varchar</FONT></TD></TR><TR><TD ALIGN="LEFT">full_name</TD><TD ALIGN="LEFT"><FONT COLOR="#64748B">varchar</FONT></TD></TR><TR><TD ALIGN="LEFT">registered_channel</TD><TD ALIGN="LEFT"><FONT COLOR="#64748B">varchar</FONT></TD></TR><TR><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT"><FONT COLOR="#64748B">timestamptz</FONT></TD></TR></TABLE>>];
  inventorysync_order_origins [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD COLSPAN="2" BGCOLOR="#DBEAFE"><B>inventorysync_order_origins</B></TD></TR><TR><TD ALIGN="LEFT"><B>order_id</B> (PK)</TD><TD ALIGN="LEFT"><FONT COLOR="#64748B">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT">point_of_sale_code</TD><TD ALIGN="LEFT"><FONT COLOR="#64748B">varchar</FONT></TD></TR><TR><TD ALIGN="LEFT">registered_at</TD><TD ALIGN="LEFT"><FONT COLOR="#64748B">timestamptz</FONT></TD></TR></TABLE>>];
  online_store_receipts [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD COLSPAN="2" BGCOLOR="#DBEAFE"><B>online_store_receipts</B></TD></TR><TR><TD ALIGN="LEFT"><B>folio</B> (PK)</TD><TD ALIGN="LEFT"><FONT COLOR="#64748B">varchar</FONT></TD></TR><TR><TD ALIGN="LEFT">shipment_folio</TD><TD ALIGN="LEFT"><FONT COLOR="#64748B">varchar</FONT></TD></TR><TR><TD ALIGN="LEFT">origin</TD><TD ALIGN="LEFT"><FONT COLOR="#64748B">varchar</FONT></TD></TR><TR><TD ALIGN="LEFT">product_id</TD><TD ALIGN="LEFT"><FONT COLOR="#64748B">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT">sku</TD><TD ALIGN="LEFT"><FONT COLOR="#64748B">varchar</FONT></TD></TR><TR><TD ALIGN="LEFT">name</TD><TD ALIGN="LEFT"><FONT COLOR="#64748B">varchar</FONT></TD></TR><TR><TD ALIGN="LEFT">description</TD><TD ALIGN="LEFT"><FONT COLOR="#64748B">varchar</FONT></TD></TR><TR><TD ALIGN="LEFT">price</TD><TD ALIGN="LEFT"><FONT COLOR="#64748B">numeric</FONT></TD></TR><TR><TD ALIGN="LEFT">quantity</TD><TD ALIGN="LEFT"><FONT COLOR="#64748B">integer</FONT></TD></TR><TR><TD ALIGN="LEFT">status</TD><TD ALIGN="LEFT"><FONT COLOR="#64748B">varchar</FONT></TD></TR><TR><TD ALIGN="LEFT">occurred_at</TD><TD ALIGN="LEFT"><FONT COLOR="#64748B">timestamptz</FONT></TD></TR><TR><TD ALIGN="LEFT">received_by</TD><TD ALIGN="LEFT"><FONT COLOR="#64748B">varchar</FONT></TD></TR><TR><TD ALIGN="LEFT">received_at</TD><TD ALIGN="LEFT"><FONT COLOR="#64748B">timestamptz</FONT></TD></TR></TABLE>>];
  online_catalog_products [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD COLSPAN="2" BGCOLOR="#DBEAFE"><B>online_catalog_products</B></TD></TR><TR><TD ALIGN="LEFT"><B>product_id</B> (PK)</TD><TD ALIGN="LEFT"><FONT COLOR="#64748B">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT">sku</TD><TD ALIGN="LEFT"><FONT COLOR="#64748B">varchar</FONT></TD></TR><TR><TD ALIGN="LEFT">name</TD><TD ALIGN="LEFT"><FONT COLOR="#64748B">varchar</FONT></TD></TR><TR><TD ALIGN="LEFT">description</TD><TD ALIGN="LEFT"><FONT COLOR="#64748B">varchar</FONT></TD></TR><TR><TD ALIGN="LEFT">category</TD><TD ALIGN="LEFT"><FONT COLOR="#64748B">varchar</FONT></TD></TR><TR><TD ALIGN="LEFT">price</TD><TD ALIGN="LEFT"><FONT COLOR="#64748B">numeric</FONT></TD></TR><TR><TD ALIGN="LEFT">published</TD><TD ALIGN="LEFT"><FONT COLOR="#64748B">boolean</FONT></TD></TR><TR><TD ALIGN="LEFT">published_at</TD><TD ALIGN="LEFT"><FONT COLOR="#64748B">timestamptz</FONT></TD></TR><TR><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT"><FONT COLOR="#64748B">timestamptz</FONT></TD></TR><TR><TD ALIGN="LEFT">updated_at</TD><TD ALIGN="LEFT"><FONT COLOR="#64748B">timestamptz</FONT></TD></TR></TABLE>>];
  online_catalog_images [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD COLSPAN="2" BGCOLOR="#DBEAFE"><B>online_catalog_images</B></TD></TR><TR><TD ALIGN="LEFT"><B>product_id</B> (PK) (FK)</TD><TD ALIGN="LEFT"><FONT COLOR="#64748B">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT">content_type</TD><TD ALIGN="LEFT"><FONT COLOR="#64748B">varchar</FONT></TD></TR><TR><TD ALIGN="LEFT">data</TD><TD ALIGN="LEFT"><FONT COLOR="#64748B">bytea</FONT></TD></TR><TR><TD ALIGN="LEFT">updated_at</TD><TD ALIGN="LEFT"><FONT COLOR="#64748B">timestamptz</FONT></TD></TR></TABLE>>];
  online_store_transfers [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD COLSPAN="2" BGCOLOR="#DBEAFE"><B>online_store_transfers</B></TD></TR><TR><TD ALIGN="LEFT"><B>id</B> (PK)</TD><TD ALIGN="LEFT"><FONT COLOR="#64748B">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT">folio</TD><TD ALIGN="LEFT"><FONT COLOR="#64748B">varchar</FONT></TD></TR><TR><TD ALIGN="LEFT">product_id</TD><TD ALIGN="LEFT"><FONT COLOR="#64748B">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT">sku</TD><TD ALIGN="LEFT"><FONT COLOR="#64748B">varchar</FONT></TD></TR><TR><TD ALIGN="LEFT">name</TD><TD ALIGN="LEFT"><FONT COLOR="#64748B">varchar</FONT></TD></TR><TR><TD ALIGN="LEFT">quantity</TD><TD ALIGN="LEFT"><FONT COLOR="#64748B">integer</FONT></TD></TR><TR><TD ALIGN="LEFT">destination</TD><TD ALIGN="LEFT"><FONT COLOR="#64748B">varchar</FONT></TD></TR><TR><TD ALIGN="LEFT">reason</TD><TD ALIGN="LEFT"><FONT COLOR="#64748B">varchar</FONT></TD></TR><TR><TD ALIGN="LEFT">requested_by</TD><TD ALIGN="LEFT"><FONT COLOR="#64748B">varchar</FONT></TD></TR><TR><TD ALIGN="LEFT">sync_status</TD><TD ALIGN="LEFT"><FONT COLOR="#64748B">varchar</FONT></TD></TR><TR><TD ALIGN="LEFT">central_folio</TD><TD ALIGN="LEFT"><FONT COLOR="#64748B">varchar</FONT></TD></TR><TR><TD ALIGN="LEFT">destination_folio</TD><TD ALIGN="LEFT"><FONT COLOR="#64748B">varchar</FONT></TD></TR><TR><TD ALIGN="LEFT">sync_attempts</TD><TD ALIGN="LEFT"><FONT COLOR="#64748B">integer</FONT></TD></TR><TR><TD ALIGN="LEFT">last_sync_error</TD><TD ALIGN="LEFT"><FONT COLOR="#64748B">varchar</FONT></TD></TR><TR><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT"><FONT COLOR="#64748B">timestamptz</FONT></TD></TR><TR><TD ALIGN="LEFT">synced_at</TD><TD ALIGN="LEFT"><FONT COLOR="#64748B">timestamptz</FONT></TD></TR></TABLE>>];
  online_store_sync_log [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD COLSPAN="2" BGCOLOR="#DBEAFE"><B>online_store_sync_log</B></TD></TR><TR><TD ALIGN="LEFT"><B>id</B> (PK)</TD><TD ALIGN="LEFT"><FONT COLOR="#64748B">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT">direction</TD><TD ALIGN="LEFT"><FONT COLOR="#64748B">varchar</FONT></TD></TR><TR><TD ALIGN="LEFT">kind</TD><TD ALIGN="LEFT"><FONT COLOR="#64748B">varchar</FONT></TD></TR><TR><TD ALIGN="LEFT">reference</TD><TD ALIGN="LEFT"><FONT COLOR="#64748B">varchar</FONT></TD></TR><TR><TD ALIGN="LEFT">result</TD><TD ALIGN="LEFT"><FONT COLOR="#64748B">varchar</FONT></TD></TR><TR><TD ALIGN="LEFT">detail</TD><TD ALIGN="LEFT"><FONT COLOR="#64748B">varchar</FONT></TD></TR><TR><TD ALIGN="LEFT">occurred_at</TD><TD ALIGN="LEFT"><FONT COLOR="#64748B">timestamptz</FONT></TD></TR></TABLE>>];
  online_store_stock_events [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD COLSPAN="2" BGCOLOR="#DBEAFE"><B>online_store_stock_events</B></TD></TR><TR><TD ALIGN="LEFT"><B>event_id</B> (PK)</TD><TD ALIGN="LEFT"><FONT COLOR="#64748B">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT">folio</TD><TD ALIGN="LEFT"><FONT COLOR="#64748B">varchar</FONT></TD></TR><TR><TD ALIGN="LEFT">received_at</TD><TD ALIGN="LEFT"><FONT COLOR="#64748B">timestamptz</FONT></TD></TR></TABLE>>];
  customer_contacts [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD COLSPAN="2" BGCOLOR="#DBEAFE"><B>customer_contacts</B></TD></TR><TR><TD ALIGN="LEFT"><B>id</B> (PK)</TD><TD ALIGN="LEFT"><FONT COLOR="#64748B">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT">customer_id</TD><TD ALIGN="LEFT"><FONT COLOR="#64748B">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT">channel</TD><TD ALIGN="LEFT"><FONT COLOR="#64748B">varchar</FONT></TD></TR><TR><TD ALIGN="LEFT">destination_token</TD><TD ALIGN="LEFT"><FONT COLOR="#64748B">varchar</FONT></TD></TR><TR><TD ALIGN="LEFT">enabled</TD><TD ALIGN="LEFT"><FONT COLOR="#64748B">boolean</FONT></TD></TR><TR><TD ALIGN="LEFT">preference_rank</TD><TD ALIGN="LEFT"><FONT COLOR="#64748B">integer</FONT></TD></TR><TR><TD ALIGN="LEFT">verified_at</TD><TD ALIGN="LEFT"><FONT COLOR="#64748B">timestamptz</FONT></TD></TR><TR><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT"><FONT COLOR="#64748B">timestamptz</FONT></TD></TR><TR><TD ALIGN="LEFT">updated_at</TD><TD ALIGN="LEFT"><FONT COLOR="#64748B">timestamptz</FONT></TD></TR></TABLE>>];
  shipments [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD COLSPAN="2" BGCOLOR="#FDE68A"><B>shipments</B> (columnas nuevas en Fase 2)</TD></TR><TR><TD ALIGN="LEFT">+ origin_code</TD><TD ALIGN="LEFT"><FONT COLOR="#64748B">varchar</FONT></TD></TR></TABLE>>];
  erp_sales [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD COLSPAN="2" BGCOLOR="#FDE68A"><B>erp_sales</B> (columnas nuevas en Fase 2)</TD></TR><TR><TD ALIGN="LEFT">+ channel</TD><TD ALIGN="LEFT"><FONT COLOR="#64748B">varchar</FONT></TD></TR></TABLE>>];
  online_catalog_images -> online_catalog_products [label="product_id", fontsize=7, fontname="Arial"];
}
