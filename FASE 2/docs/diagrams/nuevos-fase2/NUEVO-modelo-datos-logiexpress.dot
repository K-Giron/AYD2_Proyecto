// NUEVO (Fase 2, Kevin Girón): generado por generar-er-fase2.py desde las migraciones reales.
// No sustituye a SGO-Logic-Modelo-ER.drawio ni a modelo-datos.md.
digraph ER_Fase2 {
  graph [label=<<B>NUEVO · Modelo de datos Fase 2 — LogiExpress (logiexpress-service, logiexpress-db)</B><BR/><FONT POINT-SIZE="10">Generado desde Flyway · cada sistema tiene su base y no lee tablas de otro (solo API o eventos)</FONT>>, labelloc=t, rankdir=LR, fontname="Arial", fontsize=14, bgcolor="#F8FAFC", nodesep=0.2, ranksep=0.6];
  node [shape=plaintext, fontname="Arial", fontsize=8];
  edge [color="#64748B", arrowsize=0.6];
  guides [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD COLSPAN="2" BGCOLOR="#FEF08A"><B>guides</B></TD></TR><TR><TD ALIGN="LEFT"><B>id</B> (PK)</TD><TD ALIGN="LEFT"><FONT COLOR="#64748B">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT">tracking_number</TD><TD ALIGN="LEFT"><FONT COLOR="#64748B">varchar</FONT></TD></TR><TR><TD ALIGN="LEFT">merchant</TD><TD ALIGN="LEFT"><FONT COLOR="#64748B">varchar</FONT></TD></TR><TR><TD ALIGN="LEFT">merchant_reference</TD><TD ALIGN="LEFT"><FONT COLOR="#64748B">varchar</FONT></TD></TR><TR><TD ALIGN="LEFT">order_reference</TD><TD ALIGN="LEFT"><FONT COLOR="#64748B">varchar</FONT></TD></TR><TR><TD ALIGN="LEFT">origin</TD><TD ALIGN="LEFT"><FONT COLOR="#64748B">varchar</FONT></TD></TR><TR><TD ALIGN="LEFT">destination</TD><TD ALIGN="LEFT"><FONT COLOR="#64748B">varchar</FONT></TD></TR><TR><TD ALIGN="LEFT">pickup_point</TD><TD ALIGN="LEFT"><FONT COLOR="#64748B">varchar</FONT></TD></TR><TR><TD ALIGN="LEFT">status</TD><TD ALIGN="LEFT"><FONT COLOR="#64748B">varchar</FONT></TD></TR><TR><TD ALIGN="LEFT">courier</TD><TD ALIGN="LEFT"><FONT COLOR="#64748B">varchar</FONT></TD></TR><TR><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT"><FONT COLOR="#64748B">timestamptz</FONT></TD></TR><TR><TD ALIGN="LEFT">updated_at</TD><TD ALIGN="LEFT"><FONT COLOR="#64748B">timestamptz</FONT></TD></TR><TR><TD ALIGN="LEFT">version</TD><TD ALIGN="LEFT"><FONT COLOR="#64748B">bigint</FONT></TD></TR></TABLE>>];
  guide_events [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD COLSPAN="2" BGCOLOR="#FEF08A"><B>guide_events</B></TD></TR><TR><TD ALIGN="LEFT"><B>id</B> (PK)</TD><TD ALIGN="LEFT"><FONT COLOR="#64748B">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT">guide_id (FK)</TD><TD ALIGN="LEFT"><FONT COLOR="#64748B">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT">status</TD><TD ALIGN="LEFT"><FONT COLOR="#64748B">varchar</FONT></TD></TR><TR><TD ALIGN="LEFT">note</TD><TD ALIGN="LEFT"><FONT COLOR="#64748B">varchar</FONT></TD></TR><TR><TD ALIGN="LEFT">actor</TD><TD ALIGN="LEFT"><FONT COLOR="#64748B">varchar</FONT></TD></TR><TR><TD ALIGN="LEFT">occurred_at</TD><TD ALIGN="LEFT"><FONT COLOR="#64748B">timestamptz</FONT></TD></TR></TABLE>>];
  operation_settings [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD COLSPAN="2" BGCOLOR="#FEF08A"><B>operation_settings</B></TD></TR><TR><TD ALIGN="LEFT"><B>id</B> (PK)</TD><TD ALIGN="LEFT"><FONT COLOR="#64748B">smallint</FONT></TD></TR><TR><TD ALIGN="LEFT">mode</TD><TD ALIGN="LEFT"><FONT COLOR="#64748B">varchar</FONT></TD></TR><TR><TD ALIGN="LEFT">slow_latency_ms</TD><TD ALIGN="LEFT"><FONT COLOR="#64748B">integer</FONT></TD></TR><TR><TD ALIGN="LEFT">updated_by</TD><TD ALIGN="LEFT"><FONT COLOR="#64748B">varchar</FONT></TD></TR><TR><TD ALIGN="LEFT">updated_at</TD><TD ALIGN="LEFT"><FONT COLOR="#64748B">timestamptz</FONT></TD></TR></TABLE>>];
  guide_events -> guides [label="guide_id", fontsize=7, fontname="Arial"];
}
