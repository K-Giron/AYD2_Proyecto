  store_transfers [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD COLSPAN="2" BGCOLOR="#D1FAE5"><B>store_transfers</B></TD></TR><TR><TD ALIGN="LEFT"><B>id</B> (PK)</TD><TD ALIGN="LEFT"><FONT COLOR="#64748B">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT">central_folio</TD><TD ALIGN="LEFT"><FONT COLOR="#64748B">varchar</FONT></TD></TR><TR><TD ALIGN="LEFT">origin_pos_id (FK)</TD><TD ALIGN="LEFT"><FONT COLOR="#64748B">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT">origin_pos_code</TD><TD ALIGN="LEFT"><FONT COLOR="#64748B">varchar</FONT></TD></TR><TR><TD ALIGN="LEFT">local_folio</TD><TD ALIGN="LEFT"><FONT COLOR="#64748B">varchar</FONT></TD></TR><TR><TD ALIGN="LEFT">article_id (FK)</TD><TD ALIGN="LEFT"><FONT COLOR="#64748B">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT">quantity</TD><TD ALIGN="LEFT"><FONT COLOR="#64748B">integer</FONT></TD></TR><TR><TD ALIGN="LEFT">destination</TD><TD ALIGN="LEFT"><FONT COLOR="#64748B">varchar</FONT></TD></TR><TR><TD ALIGN="LEFT">destination_folio</TD><TD ALIGN="LEFT"><FONT COLOR="#64748B">varchar</FONT></TD></TR><TR><TD ALIGN="LEFT">reason</TD><TD ALIGN="LEFT"><FONT COLOR="#64748B">varchar</FONT></TD></TR><TR><TD ALIGN="LEFT">seller</TD><TD ALIGN="LEFT"><FONT COLOR="#64748B">varchar</FONT></TD></TR><TR><TD ALIGN="LEFT">occurred_at</TD><TD ALIGN="LEFT"><FONT COLOR="#64748B">timestamptz</FONT></TD></TR></TABLE>>];
