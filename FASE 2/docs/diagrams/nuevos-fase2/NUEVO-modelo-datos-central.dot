  pos_stock_movements [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD COLSPAN="2" BGCOLOR="#D1FAE5"><B>pos_stock_movements</B></TD></TR><TR><TD ALIGN="LEFT"><B>id</B> (PK)</TD><TD ALIGN="LEFT"><FONT COLOR="#64748B">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT">folio</TD><TD ALIGN="LEFT"><FONT COLOR="#64748B">varchar</FONT></TD></TR><TR><TD ALIGN="LEFT">point_of_sale_id (FK)</TD><TD ALIGN="LEFT"><FONT COLOR="#64748B">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT">article_id (FK)</TD><TD ALIGN="LEFT"><FONT COLOR="#64748B">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT">quantity</TD><TD ALIGN="LEFT"><FONT COLOR="#64748B">integer</FONT></TD></TR><TR><TD ALIGN="LEFT">origin_warehouse_folio</TD><TD ALIGN="LEFT"><FONT COLOR="#64748B">varchar</FONT></TD></TR><TR><TD ALIGN="LEFT">occurred_at</TD><TD ALIGN="LEFT"><FONT COLOR="#64748B">timestamptz</FONT></TD></TR><TR><TD ALIGN="LEFT">movement_type</TD><TD ALIGN="LEFT"><FONT COLOR="#64748B">varchar</FONT></TD></TR><TR><TD ALIGN="LEFT">external_reference</TD><TD ALIGN="LEFT"><FONT COLOR="#64748B">varchar</FONT></TD></TR></TABLE>>];
  store_invoices [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD COLSPAN="2" BGCOLOR="#D1FAE5"><B>store_invoices</B></TD></TR><TR><TD ALIGN="LEFT"><B>id</B> (PK)</TD><TD ALIGN="LEFT"><FONT COLOR="#64748B">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT">central_folio</TD><TD ALIGN="LEFT"><FONT COLOR="#64748B">varchar</FONT></TD></TR><TR><TD ALIGN="LEFT">point_of_sale_id (FK)</TD><TD ALIGN="LEFT"><FONT COLOR="#64748B">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT">point_of_sale_code</TD><TD ALIGN="LEFT"><FONT COLOR="#64748B">varchar</FONT></TD></TR><TR><TD ALIGN="LEFT">ticket_folio</TD><TD ALIGN="LEFT"><FONT COLOR="#64748B">varchar</FONT></TD></TR><TR><TD ALIGN="LEFT">issued_at</TD><TD ALIGN="LEFT"><FONT COLOR="#64748B">timestamptz</FONT></TD></TR><TR><TD ALIGN="LEFT">received_at</TD><TD ALIGN="LEFT"><FONT COLOR="#64748B">timestamptz</FONT></TD></TR><TR><TD ALIGN="LEFT">seller</TD><TD ALIGN="LEFT"><FONT COLOR="#64748B">varchar</FONT></TD></TR><TR><TD ALIGN="LEFT">tax_id</TD><TD ALIGN="LEFT"><FONT COLOR="#64748B">varchar</FONT></TD></TR><TR><TD ALIGN="LEFT">customer_name</TD><TD ALIGN="LEFT"><FONT COLOR="#64748B">varchar</FONT></TD></TR><TR><TD ALIGN="LEFT">payment_method</TD><TD ALIGN="LEFT"><FONT COLOR="#64748B">varchar</FONT></TD></TR><TR><TD ALIGN="LEFT">total</TD><TD ALIGN="LEFT"><FONT COLOR="#64748B">numeric</FONT></TD></TR></TABLE>>];
