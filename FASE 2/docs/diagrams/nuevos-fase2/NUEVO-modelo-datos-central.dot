// NUEVO (Fase 2, Kevin Girón): generado por generar-er-fase2.py desde las migraciones reales.
// No sustituye a SGO-Logic-Modelo-ER.drawio ni a modelo-datos.md.
digraph ER_Fase2 {
  graph [label=<<B>NUEVO · Modelo de datos Fase 2 — Almacén central (inventory-service, inventory-db)</B><BR/><FONT POINT-SIZE="10">Generado desde Flyway · cada sistema tiene su base y no lee tablas de otro (solo API o eventos)</FONT>>, labelloc=t, rankdir=LR, fontname="Arial", fontsize=14, bgcolor="#F8FAFC", nodesep=0.2, ranksep=0.6];
