// NUEVO (Fase 2, Kevin Girón, 2026-10-07): bloques y contexto de Fase 2.
// No sustituye a Docs/diagramas/bloques.dot ni contexto.dot (Fase 1).
digraph SGO_Bloques_Fase2 {
  graph [label=<<B>NUEVO · SGO-Logic Fase 2 — Diagrama de bloques: quién centraliza qué</B><BR/><FONT POINT-SIZE="10">El central consolida el inventario · SGO-Logic consolida y concilia las ventas · el ERP solo recibe archivos</FONT>>,
         labelloc=t, rankdir=TB, bgcolor="#F8FAFC", fontname="Arial", fontsize=14, pad=0.3, nodesep=0.5, ranksep=0.7];
  node [shape=box, style="rounded,filled", fillcolor="#FFFFFF", color="#94A3B8", fontname="Arial", fontsize=9, margin="0.15,0.1"];
  edge [color="#64748B", fontcolor="#334155", fontname="Arial", fontsize=7.5, arrowsize=0.6];

  canales [fillcolor="#EFF6FF", color="#93C5FD", label="Canales de venta\nweb · móvil · call center · tienda física"];

  sgo [fillcolor="#DBEAFE", color="#2563EB", penwidth=2, label="SGO-Logic\nórdenes y carrito omnicanal · pagos · facturación\ndespacho y rastreo · atención al cliente\nconsolida y CONCILIA ventas (informe auditado)"];
  central [fillcolor="#D1FAE5", color="#10B981", penwidth=2, label="Almacén central\nconsolida el INVENTARIO de la red:\nalmacén + stock propio de cada punto de venta\nfolios de entrada/salida/traslado"];

  subgraph cluster_pv {
    label="Puntos de venta (cada uno con su almacén)"; style="rounded,filled"; fillcolor="#FFF7ED"; color="#F97316"; fontname="Arial";
    online [fillcolor="#FFEDD5", label="Tienda online\nPOS-ONLINE / CD-WEB\n(dentro de SGO-Logic)"];
    pos01 [fillcolor="#FFEDD5", label="Tienda física POS-01\nPOS local (store-service)"];
    pos32 [fillcolor="#FFFFFF", label="Tiendas 2..32\nPOS legados"];
  }

  subgraph cluster_prov {
    label="Proveedores contratados (sistemas propios)"; style="rounded,filled"; fillcolor="#F5F3FF"; color="#8B5CF6"; fontname="Arial";
    payklik [fillcolor="#EDE9FE", label="PayKlik\ncobros"];
    logi [fillcolor="#FEF08A", label="LogiExpress\nguías y entregas"];
    sat [label="SAT\nfactura electrónica"];
  }

  subgraph cluster_legado {
    label="Legado sin modificar"; style="rounded,filled"; fillcolor="#FEF2F2"; color="#FCA5A5"; fontname="Arial";
    erp [label="ERP AS/400\nCONTABILIDAD: solo recibe\nCSV/XML cada 30 min"];
  }

  canales -> sgo [label="compras, consultas, atención"];
  canales -> pos01 [label="venta presencial"];
  sgo -> payklik [label="autoriza / concilia"];
  sgo -> logi [label="guía / rastreo"];
  sgo -> sat [label="XML fiscal"];
  sgo -> erp [label="resumen de ventas conciliado"];
  sgo -> pos32 [label="eventos de órdenes"];
  sgo -> pos01 [label="eventos de órdenes,\nlisto para recoger"];
  central -> online [label="folios + eventos de stock"];
  central -> pos01 [label="folios + eventos de stock"];
  pos01 -> central [label="facturas, traslados"];
  online -> central [label="ventas web, traslados"];
  central -> sgo [label="facturas de tienda (para el ERP)", style=dashed];
  logi -> pos01 [label="entrega el paquete\npara retiro", style=dashed];
}
