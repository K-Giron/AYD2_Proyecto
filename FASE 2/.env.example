BACKEND_PORT=8080
FRONTEND_PORT=8081
POSTGRES_DB=sgo_logic_local
POSTGRES_USER=sgo_local
POSTGRES_PASSWORD=local_only_change_me
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
RABBITMQ_USER=sgo_local
RABBITMQ_PASSWORD=local_only_change_me
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
SPRING_PROFILES_ACTIVE=local

# BB-06: SUCCESS, REJECTION, LATENCY, TIMEOUT, OUTAGE o RANDOM.
SGO_SIMULATORS_PAYKLIK_MODE=SUCCESS
SGO_SIMULATORS_SAT_MODE=SUCCESS
SGO_SIMULATORS_ERP_MODE=SUCCESS
SGO_SIMULATORS_POS_MODE=SUCCESS
SGO_SIMULATORS_LOGIEXPRESS_MODE=RANDOM
SGO_SIMULATORS_NOTIFICATIONS_MODE=RANDOM

# Latencias simuladas en milisegundos y tasas de falla para modo RANDOM.
SGO_SIMULATORS_PAYKLIK_LATENCY_MS=1200
SGO_SIMULATORS_SAT_LATENCY_MS=1500
SGO_SIMULATORS_ERP_LATENCY_MS=1000
SGO_SIMULATORS_POS_LATENCY_MS=400
SGO_SIMULATORS_LOGIEXPRESS_LATENCY_MS=800
SGO_SIMULATORS_NOTIFICATIONS_LATENCY_MS=500
SGO_SIMULATORS_PAYKLIK_FAILURE_RATE=0.10
SGO_SIMULATORS_SAT_FAILURE_RATE=0.10
SGO_SIMULATORS_ERP_FAILURE_RATE=0.05
SGO_SIMULATORS_POS_FAILURE_RATE=0.05
SGO_SIMULATORS_LOGIEXPRESS_FAILURE_RATE=0.02
SGO_SIMULATORS_NOTIFICATIONS_FAILURE_RATE=0.05

# Lista opcional separada por comas, limitada a tiendas 1-32.
SGO_SIMULATORS_POS_UNAVAILABLE_STORES=

# ERP-01: CSV o XML; 30 minutos por defecto.
SGO_ERP_FORMAT=CSV
SGO_ERP_INTERVAL_MS=1800000
SGO_ERP_INITIAL_DELAY_MS=1800000

# BB-04: Outbox transaccional. max-attempts incluye el intento inicial
# (1 intento + 3 reintentos = 4) y retry-delays usa formato de duración.
SGO_OUTBOX_ENABLED=true
SGO_OUTBOX_POLL_INTERVAL_MS=2000
SGO_OUTBOX_BATCH_SIZE=50
SGO_OUTBOX_MAX_ATTEMPTS=4
SGO_OUTBOX_RETRY_DELAYS=2s,8s,32s
SGO_OUTBOX_EXCHANGE=sgo.events
SGO_OUTBOX_DLX=sgo.events.dlx
SGO_OUTBOX_DLQ=sgo.events.dlq

# BB-07: autenticacion JWT (HMAC-SHA256) y cuentas de demostracion locales.
# Son valores ficticios exclusivamente locales; un ambiente real debe
# reemplazarlos y no versionarlos.
SGO_SECURITY_ENABLED=true
SGO_SECURITY_JWT_SECRET=local_dev_only_jwt_secret_change_me_32b!
SGO_SECURITY_JWT_ISSUER=sgo-logic
SGO_SECURITY_JWT_TTL=PT8H
SGO_SECURITY_CLIENT_USER=cliente@megastore.com
SGO_SECURITY_CLIENT_PASSWORD=Cliente123
SGO_SECURITY_SUPPORT_USER=staff@megastore.com
SGO_SECURITY_SUPPORT_PASSWORD=Staff123
SGO_SECURITY_LOGISTICS_USER=logistica@megastore.com
SGO_SECURITY_LOGISTICS_PASSWORD=Logistica123
SGO_SECURITY_FINANCE_USER=finanzas@megastore.com
SGO_SECURITY_FINANCE_PASSWORD=Finanzas123
