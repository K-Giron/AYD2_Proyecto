#!/bin/sh
set -eu

MAVEN_VERSION=3.9.11
MAVEN_ARCHIVE="apache-maven-${MAVEN_VERSION}-bin.tar.gz"
MAVEN_URL="https://archive.apache.org/dist/maven/maven-3/${MAVEN_VERSION}/binaries/${MAVEN_ARCHIVE}"
MAVEN_SHA512="bcfe4fe305c962ace56ac7b5fc7a08b87d5abd8b7e89027ab251069faebee516b0ded8961445d6d91ec1985dfe30f8153268843c89aa392733d1a3ec956c9978"
MAVEN_CACHE_ROOT="${MAVEN_USER_HOME:-${HOME}/.m2}/wrapper/dists/apache-maven-${MAVEN_VERSION}"
MAVEN_HOME_DIR="${MAVEN_CACHE_ROOT}/apache-maven-${MAVEN_VERSION}"

if [ ! -x "${MAVEN_HOME_DIR}/bin/mvn" ]; then
  mkdir -p "${MAVEN_CACHE_ROOT}"
  ARCHIVE_PATH="${MAVEN_CACHE_ROOT}/${MAVEN_ARCHIVE}"
  if command -v curl >/dev/null 2>&1; then
    curl --fail --location --silent --show-error "${MAVEN_URL}" --output "${ARCHIVE_PATH}"
  elif command -v wget >/dev/null 2>&1; then
    wget -q "${MAVEN_URL}" -O "${ARCHIVE_PATH}"
  else
    echo "Se requiere curl o wget para descargar Maven ${MAVEN_VERSION}." >&2
    exit 1
  fi
  printf '%s  %s\n' "${MAVEN_SHA512}" "${ARCHIVE_PATH}" | sha512sum --check --status
  tar -xzf "${ARCHIVE_PATH}" -C "${MAVEN_CACHE_ROOT}"
  rm -f "${ARCHIVE_PATH}"
fi

exec "${MAVEN_HOME_DIR}/bin/mvn" "$@"
