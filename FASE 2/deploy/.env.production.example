# Producción (GCP) — ADR-017. Este archivo es la PLANTILLA del secreto
# PROD_ENV_FILE de GitHub Actions: cópielo, reemplace cada CAMBIAR_* por un
# valor aleatorio largo (p. ej. `openssl rand -base64 32`) y pegue el
# resultado completo en Settings → Secrets → Actions → PROD_ENV_FILE.
# Nunca versione el archivo con valores reales.
#
# Las cuentas de demostración de personas (cliente, staff, finanzas,
# tienda online, almacén) conservan las contraseñas del README para que
# los calificadores puedan entrar; todo lo demás (bases, JWT, llaves de
# comercio, cuentas de servicio) debe ser nuevo.

# --- Despliegue (los completa el pipeline; aquí van valores de ejemplo) ---
IMAGE_REGISTRY=ghcr.io/OWNER_EN_MINUSCULAS
IMAGE_TAG=v1
PUBLIC_HTTP_PORT=80

BACKEND_PORT=8080
FRONTEND_PORT=8081
POSTGRES_DB=sgo_logic_local
POSTGRES_USER=sgo_local
POSTGRES_PASSWORD=CAMBIAR_postgres_password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
RABBITMQ_USER=sgo_local
RABBITMQ_PASSWORD=CAMBIAR_rabbitmq_password
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
SPRING_PROFILES_ACTIVE=local

# Almacén central (inventory-service): sistema propio con su propia base
# de datos. Login JWT con tres roles: ALMACEN, FINANZAS y LOGISTICA.
INVENTORY_POSTGRES_DB=inventory_service_local
INVENTORY_POSTGRES_USER=inventory_local
INVENTORY_POSTGRES_PASSWORD=CAMBIAR_inventory_postgres_password
INVENTORY_POSTGRES_PORT=5434
INVENTORY_SERVICE_PORT=8082
INVENTORY_JWT_SECRET=CAMBIAR_inventory_jwt_secret
INVENTORY_ALMACEN_USER=almacen@almacencentral.local
INVENTORY_ALMACEN_PASSWORD=Almacen123
INVENTORY_FINANZAS_USER=finanzas@almacencentral.local
INVENTORY_FINANZAS_PASSWORD=Finanzas123
INVENTORY_LOGISTICA_USER=logistica@almacencentral.local
INVENTORY_LOGISTICA_PASSWORD=Logistica123
# Cuenta de servicio propia para la integración del monolito (módulo
# inventorysync) — no es una cuenta humana, por eso tiene su propia
# identidad en vez de reusar la de logística.
INVENTORY_WEB_SYNC_USER=integracion-web@almacencentral.local
INVENTORY_WEB_SYNC_PASSWORD=CAMBIAR_inventory_web_sync_password

# inventorysync (monolito → inventory-service): registra en el almacén
# central cada venta real confirmada en la web, contra el punto de venta
# "Tienda Online" (POS-ONLINE, sembrado en inventory-service V15).
SGO_INTEGRATIONS_INVENTORY_BASE_URL=http://inventory-service:8080
SGO_INTEGRATIONS_INVENTORY_USERNAME=integracion-web@almacencentral.local
SGO_INTEGRATIONS_INVENTORY_PASSWORD=CAMBIAR_sgo_integrations_inventory_password
SGO_INTEGRATIONS_INVENTORY_TIMEOUT_MS=5000

# BB-06: SUCCESS, REJECTION, LATENCY, TIMEOUT, OUTAGE o RANDOM.
# PayKlik y LogiExpress ya son sistemas propios (payklik-service y logiexpress-service):
# sus modos *_PAYKLIK_* y *_LOGIEXPRESS_* solo aplican a las pruebas automáticas.
# Para probar sus fallas en vivo usa "Estado del servicio" en su portal (:8086 / :8085).
SGO_SIMULATORS_PAYKLIK_MODE=SUCCESS
SGO_SIMULATORS_SAT_MODE=SUCCESS
SGO_SIMULATORS_ERP_MODE=SUCCESS
SGO_SIMULATORS_POS_MODE=SUCCESS
SGO_SIMULATORS_LOGIEXPRESS_MODE=RANDOM
SGO_SIMULATORS_NOTIFICATIONS_MODE=RANDOM

# Latencias simuladas en milisegundos y tasas de falla para modo RANDOM.
SGO_SIMULATORS_PAYKLIK_LATENCY_MS=1200
SGO_SIMULATORS_SAT_LATENCY_MS=1500
SGO_SIMULATORS_ERP_LATENCY_MS=1000
SGO_SIMULATORS_POS_LATENCY_MS=400
SGO_SIMULATORS_LOGIEXPRESS_LATENCY_MS=800
SGO_SIMULATORS_NOTIFICATIONS_LATENCY_MS=500
SGO_SIMULATORS_PAYKLIK_FAILURE_RATE=0.10
SGO_SIMULATORS_SAT_FAILURE_RATE=0.10
SGO_SIMULATORS_ERP_FAILURE_RATE=0.05
SGO_SIMULATORS_POS_FAILURE_RATE=0.05
SGO_SIMULATORS_LOGIEXPRESS_FAILURE_RATE=0.02
SGO_SIMULATORS_NOTIFICATIONS_FAILURE_RATE=0.05

# Lista opcional separada por comas, limitada a tiendas 1-32.
SGO_SIMULATORS_POS_UNAVAILABLE_STORES=

# ERP-01: CSV o XML; 30 minutos por defecto.
SGO_ERP_FORMAT=CSV
SGO_ERP_INTERVAL_MS=1800000
SGO_ERP_INITIAL_DELAY_MS=1800000
# Carpeta (volumen erp-outbox) donde se deja cada lote para el ERP AS/400.
SGO_ERP_OUTBOX_DIR=/var/sgo/erp-outbox
# POS real de la tienda 01 (store-service); las demás tiendas usan el simulador.
SGO_POS_STORE_01_ENDPOINT=http://store-service:8080/api/store/pos-events
SGO_POS_TIMEOUT_MS=5000

# PAY-02: timeout y circuit breaker del adaptador PayKlik (ADR-003).
SGO_PAYKLIK_TIMEOUT_MS=5000
SGO_PAYKLIK_CALL_POOL_SIZE=8
SGO_PAYKLIK_FAILURE_RATE_THRESHOLD=50
SGO_PAYKLIK_SLIDING_WINDOW_SIZE=10
SGO_PAYKLIK_MINIMUM_CALLS=5
SGO_PAYKLIK_OPEN_STATE_WAIT=30s
SGO_PAYKLIK_HALF_OPEN_CALLS=3

# PAY-03: conciliacion de intentos indeterminados. El primer trabajo se
# programa en 30 s (<= 60 s) y se alerta si sigue sin resolver a los 5 min.
SGO_PAYMENT_RECONCILIATION_ENABLED=true
SGO_PAYMENT_RECONCILIATION_POLL_INTERVAL_MS=5000
SGO_PAYMENT_RECONCILIATION_BATCH_SIZE=20
SGO_PAYMENT_RECONCILIATION_MAX_ATTEMPTS=4
SGO_PAYMENT_RECONCILIATION_FIRST_DELAY=30s
SGO_PAYMENT_RECONCILIATION_STALE_PENDING_AFTER=60s
SGO_PAYMENT_RECONCILIATION_RETRY_DELAYS=60s,120s,240s
SGO_PAYMENT_RECONCILIATION_ALERT_AFTER=5m

# BB-04: Outbox transaccional. max-attempts incluye el intento inicial
# (1 intento + 3 reintentos = 4) y retry-delays usa formato de duración.
SGO_OUTBOX_ENABLED=true
SGO_OUTBOX_POLL_INTERVAL_MS=2000
SGO_OUTBOX_BATCH_SIZE=50
SGO_OUTBOX_MAX_ATTEMPTS=4
SGO_OUTBOX_RETRY_DELAYS=2s,8s,32s
SGO_OUTBOX_EXCHANGE=sgo.events
SGO_OUTBOX_DLX=sgo.events.dlx
SGO_OUTBOX_DLQ=sgo.events.dlq

# BB-07: autenticacion JWT (HMAC-SHA256) y cuentas de demostracion locales.
# Son valores ficticios exclusivamente locales; un ambiente real debe
# reemplazarlos y no versionarlos.
SGO_SECURITY_ENABLED=true
SGO_SECURITY_JWT_SECRET=CAMBIAR_sgo_security_jwt_secret
SGO_SECURITY_JWT_ISSUER=sgo-logic
SGO_SECURITY_JWT_TTL=PT8H
SGO_SECURITY_CLIENT_USER=cliente@megastore.com
SGO_SECURITY_CLIENT_PASSWORD=Cliente123
SGO_SECURITY_SUPPORT_USER=staff@megastore.com
SGO_SECURITY_SUPPORT_PASSWORD=Staff123
SGO_SECURITY_LOGISTICS_USER=logistica@megastore.com
SGO_SECURITY_LOGISTICS_PASSWORD=Logistica123
SGO_SECURITY_FINANCE_USER=finanzas@megastore.com
SGO_SECURITY_FINANCE_PASSWORD=Finanzas123

# Sistema de tienda física POS-01 (store-service): su base propia, su
# cuenta TIENDA en el almacén central y la credencial del equipo en la web
# (cuenta de servicio con rol SUPPORT, solo para traer el carrito web de un
# cliente que quiera identificarse; el vendedor solo escribe su usuario).
STORE_SERVICE_PORT=8084
STORE_CODE=POS-01
STORE_NAME=Tienda Centro
# Emisor impreso en las facturas de la tienda (datos de demostración).
STORE_LEGAL_NAME=MegaStore, S.A.
STORE_TAX_ID=1234567-8
STORE_ADDRESS=6a. Avenida 10-25, Zona 1, Ciudad de Guatemala
STORE_TIMEZONE=America/Guatemala
STORE_POSTGRES_DB=store_pos01_local
STORE_POSTGRES_USER=store_local
STORE_POSTGRES_PASSWORD=CAMBIAR_store_postgres_password
STORE_POSTGRES_PORT=5435
INVENTORY_STORE_POS01_USER=tienda-pos01@almacencentral.local
INVENTORY_STORE_POS01_PASSWORD=CAMBIAR_inventory_store_pos01_password
# Tienda online (onlinestore): cuenta TIENDA de POS-ONLINE en el almacén
# central y la cuenta de quien administra el catálogo en la web.
INVENTORY_STORE_ONLINE_USER=tienda-online@almacencentral.local
INVENTORY_STORE_ONLINE_PASSWORD=CAMBIAR_inventory_store_online_password
SGO_SECURITY_ONLINE_STORE_USER=tienda-online@megastore.com
SGO_SECURITY_ONLINE_STORE_PASSWORD=TiendaOnline123
SGO_SECURITY_STORE_TERMINAL_USER=terminal-pos01@megastore.com
SGO_SECURITY_STORE_TERMINAL_PASSWORD=CAMBIAR_sgo_security_store_terminal_password

# Correo real de notificaciones (Gmail). SGO_MAIL_USERNAME = la cuenta de Gmail
# que envía; SGO_MAIL_PASSWORD = una "contraseña de aplicación" de 16 letras
# (https://myaccount.google.com/apppasswords, requiere verificación en 2 pasos).
# Si quedan vacías, los correos se simulan. Este archivo no se sube al repo.
SGO_MAIL_HOST=smtp.gmail.com
SGO_MAIL_PORT=587
SGO_MAIL_USERNAME=
SGO_MAIL_PASSWORD=
SGO_MAIL_FROM_NAME=MegaStore
SGO_NOTIFICATIONS_EMAIL_PROVIDER=auto
SGO_PUBLIC_SITE_URL=http://IP_PUBLICA_DE_LA_VM

# PayKlik y LogiExpress: sistemas propios de los proveedores (payklik-service
# en :8086, logiexpress-service en :8085), cada uno con su base de datos.
# SGO-Logic los llama por REST con la llave de comercio.
PAYKLIK_SERVICE_PORT=8086
PAYKLIK_POSTGRES_PORT=5437
PAYKLIK_POSTGRES_DB=payklik_local
PAYKLIK_POSTGRES_USER=payklik_local
PAYKLIK_POSTGRES_PASSWORD=CAMBIAR_payklik_postgres_password
PAYKLIK_MERCHANT_API_KEY=CAMBIAR_payklik_merchant_api_key
LOGIEXPRESS_SERVICE_PORT=8085
LOGIEXPRESS_POSTGRES_PORT=5436
LOGIEXPRESS_POSTGRES_DB=logiexpress_local
LOGIEXPRESS_POSTGRES_USER=logiexpress_local
LOGIEXPRESS_POSTGRES_PASSWORD=CAMBIAR_logiexpress_postgres_password
LOGIEXPRESS_MERCHANT_API_KEY=CAMBIAR_logiexpress_merchant_api_key
# Rastreo: cada cuánto SGO-Logic pregunta a LogiExpress qué guías cambiaron.
SGO_LOGIEXPRESS_TRACKING_INTERVAL_MS=10000
# Cuenta de servicio con la que el central entrega los eventos de stock a la tienda online.
SGO_SECURITY_CENTRAL_EVENTS_USER=central-eventos@megastore.com
SGO_SECURITY_CENTRAL_EVENTS_PASSWORD=CAMBIAR_sgo_security_central_events_password
# Liberar inventario: una reserva sin pagar se libera al vencer este tiempo
# (ISO-8601, p. ej. PT15M = 15 min; PT2M para probarlo rápido).
SGO_INVENTORY_RESERVATION_TTL=PT15M
SGO_INVENTORY_EXPIRATION_SWEEP_INTERVAL=PT1M

# Fase 3: elegibilidad de crédito (ADR-016) e identidad del cliente demo.
SGO_SECURITY_CLIENT_CUSTOMER_ID=aaaaaaaa-aaaa-aaaa-aaaa-aaaaaaaaaaaa
SGO_CREDIT_OPTIONS_TIMEOUT_MS=2000
SGO_CREDIT_OPTIONS_CALL_POOL_SIZE=4
